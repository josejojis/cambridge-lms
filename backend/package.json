{
  "name": "elite-revision-backend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "db:setup": "npm run db:generate && prisma migrate deploy && tsx prisma/seed.ts",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "start": "node --import tsx src/server.ts",
    "worker:prod": "node --import tsx src/worker.ts",
    "db:seed:production": "tsx prisma/seed-production.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism",
    "db:generate": "node scripts/sync-schemas.mjs && prisma generate",
    "db:migrate": "node scripts/sync-schemas.mjs && prisma migrate dev",
    "db:migrate:postgres": "node scripts/new-postgres-migration.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@better-auth/passkey": "^1.7.26",
    "@casl/ability": "^7.1.3",
    "@elite/shared": "*",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.5",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "^11.14.0",
    "better-auth": "^1.7.26",
    "dotenv": "^16.5.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "sanitize-html": "^2.18.2",
    "ts-fsrs": "^6.0.0",
    "tsx": "^4.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/sanitize-html": "^2.16.0",
    "better-sqlite3": "^12.11.1",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild": true
  }
}
