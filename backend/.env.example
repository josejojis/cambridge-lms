# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4000
# Browser origin of the web app (Vite dev server proxies /api to this API)
APP_ORIGIN=http://localhost:5000
BETTER_AUTH_URL=http://localhost:5000
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# Development: SQLite file (relative to backend/). Production: PostgreSQL URL (postgresql://…),
# which automatically selects prisma/postgres/schema.prisma and its migrations.
DATABASE_URL="file:./dev.db"

# Demo accounts (development seed only; it refuses to run when NODE_ENV=production)
SEED_DEMO_PASSWORD=ChangeMe!2026

# First Main Administrator, created by the production reference seed if missing (min 14 chars)
ADMIN_EMAIL=
ADMIN_NAME=Main Administrator
ADMIN_INITIAL_PASSWORD=

# Email: log (dev only) | resend
MAIL_PROVIDER=log
MAIL_FROM=Elite Revision <no-reply@elite-revision.com>
RESEND_API_KEY=

# AI (optional; features stay off until an admin enables them in settings)
ANTHROPIC_API_KEY=
AI_HINT_MODEL=claude-haiku-5-5
AI_MARKING_MODEL=claude-sonnet-5-5

# Error monitoring (optional)
SENTRY_DSN=

# ── M-Pesa Daraja (sandbox during development) ──
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ── Card gateway (provider to be decided) ──
CARD_PROVIDER=
CARD_SECRET_KEY=
CARD_WEBHOOK_SECRET=
