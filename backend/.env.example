# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=4000
# Frontend origin allowed to call the API (Vite dev server)
APP_ORIGIN=http://localhost:5000

# Development: SQLite file (relative to backend/). Production: PostgreSQL URL.
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://elite:CHANGE_ME@127.0.0.1:5432/elite_revision"

# Session cookie signing secret: 64+ random characters
SESSION_SECRET=change-me-to-a-long-random-string

# Password for every seeded DEMO account (local only). Seeding refuses to run when NODE_ENV=production.
SEED_DEMO_PASSWORD=ChangeMe!2026

# ── M-Pesa Daraja (sandbox during development) ──
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

# ── Card gateway (provider to be decided) ──
CARD_PROVIDER=
CARD_PUBLIC_KEY=
CARD_SECRET_KEY=
CARD_WEBHOOK_SECRET=

# ── Email / SMS providers (Phase 5) ──
MAIL_PROVIDER=log
SMS_PROVIDER=log
