                                },
                                "icon": {
                                  "nullable": true,
                                  "type": "string"
                                },
                                "level": {
                                  "type": "string"
                                },
                                "levelCode": {
                                  "type": "string"
                                },
                                "units": {
                                  "type": "number"
                                },
                                "courses": {
                                  "type": "array",
                                  "items": {
                                    "type": "object",
                                    "properties": {
                                      "title": {
                                        "type": "string"
                                      },
                                      "slug": {
                                        "type": "string"
                                      },
                                      "summary": {
                                        "nullable": true,
                                        "type": "string"
                                      },
                                      "lessons": {
                                        "type": "number"
                                      }
                                    },
                                    "required": [
                                      "title",
                                      "slug",
                                      "summary",
                                      "lessons"
                                    ],
                                    "additionalProperties": false
                                  }
                                }
                              },
                              "required": [
                                "subject",
                                "slug",
                                "icon",
                                "level",
                                "levelCode",
                                "units",
                                "courses"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "code",
                          "name",
                          "labels",
                          "levels",
                          "offerings"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
