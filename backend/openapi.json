        }
      }
    },
    "/api/v1/attempts/{attemptId}": {
      "get": {
        "tags": [
          "assessment"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "in": "path",
            "name": "attemptId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
    "/api/v1/attempts/{attemptId}/answers": {
      "put": {
        "tags": [
          "assessment"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "answers": {
                    "minItems": 1,
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "questionId": {
                          "type": "number"
                        },
                        "response": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "optionId": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "optionId"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "optionIds": {
                                  "type": "array",
                                  "items": {
                                    "type": "number"
                                  }
                                }
                              },
                              "required": [
                                "optionIds"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "value": {
                                  "type": "boolean"
                                }
                              },
                              "required": [
                                "value"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "blanks": {
                                  "type": "array",
                                  "items": {
                                    "type": "string",
                                    "maxLength": 500
                                  }
                                }
                              },
                              "required": [
                                "blanks"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "pairs": {
                                  "type": "object",
                                  "additionalProperties": {
                                    "type": "string"
                                  }
                                }
                              },
                              "required": [
                                "pairs"
                              ]
                            },
                            {
                              "type": "object",
                              "properties": {
                                "text": {
                                  "type": "string",
                                  "maxLength": 20000
                                }
                              },
                              "required": [
                                "text"
                              ]
                            }
                          ]
                        },
                        "clientSavedAt": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": [
                        "questionId",
                        "response",
                        "clientSavedAt"
                      ]
                    }
                  }
                },
                "required": [
                  "answers"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "in": "path",
            "name": "attemptId",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
